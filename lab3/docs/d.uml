@startuml
class Director {
  - dId: String
  - name: String
  + Director(String, String)
  + hireCoordinator(coordinator: Coordinator): void
  + result(): String
}

class Coordinator {
  - cId: String
  - name: String
  + Coordinator(String, String)
  + createProject(pId: String, title: String): Project
  + hireVolunteer(project: Project, volunteer: Volunteer): void
  + result(): String
  + equals(Object): boolean
  + hashCode(): int
}

class Project {
  - pId: String
  - title: String
  - status: boolean
  + Project(String, String, boolean)
  + addVolunteer(volunteer: Volunteer): void
  + complete(): void
  + result(): String
}

class Volunteer {
  - vId: String
  - name: String
  + Volunteer(String, String)
  + getName(): String
  + result(): String
}

Director "1" o-- "0..N" Coordinator : наймає
Coordinator "1" --> "0..N" Project : створює
Coordinator "1" --> "0..N" Volunteer : шукає та наймає
Project "0..N" o-- "1..N" Volunteer : залучає до роботи
@enduml